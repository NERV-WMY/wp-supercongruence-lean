/-- The unchanged angular coefficient denominators, without their s powers. -/
noncomputable def etaCoefficientDenominator : Fin 3 → Fin 3 → RatFunc ℚ :=
  ![![3980063587500000*symbol^2*(9*symbol - 25)*(99*symbol - 50)^3, 15920254350000*symbol^2*(9*symbol - 25)*(99*symbol - 50)^3, 644770301175000*symbol^5*(9*symbol - 25)*(99*symbol - 50)^3],
    ![1105573218750000*symbol^2*(9*symbol - 25)*(99*symbol - 50)^3, 4422292875000*symbol^2*(9*symbol - 25)*(99*symbol - 50)^3, 179102861437500*symbol^5*(99*symbol - 50)^3],
    ![552786609375000*symbol^2*(9*symbol - 25)*(99*symbol - 50)^3, 2211146437500*symbol^2*(99*symbol - 50)^3, 89551430718750*symbol^5*(99*symbol - 50)^3]]

/-- The actual angular Laurent pole orders. -/
def etaSPoleOrder : Fin 3 → Fin 3 → ℕ :=
  ![![2, 1, 1],
    ![2, 1, 1],
    ![3, 2, 2]]

/-- Multiplication by s cubed clears all nine actual angular Laurent poles. -/
noncomputable def etaClearedPolynomial (i j : Fin 3) : Polynomial (RatFunc ℚ) :=
  Polynomial.C ((etaCoefficientDenominator i j)⁻¹) *
    Polynomial.X^(3-etaSPoleOrder i j) * etaNumeratorPolynomial i j

theorem actual_eta_polynomial_fraction (i j : Fin 3) :
    bivEta i j = Polynomial.aeval bivS (etaNumeratorPolynomial i j) /
      (bivS^(etaSPoleOrder i j)*RatFunc.C (etaCoefficientDenominator i j)) := by
  fin_cases i <;> fin_cases j
  all_goals
    simp only [etaCoefficientDenominator, etaSPoleOrder, etaNumeratorPolynomial,
      bivEta, Matrix.cons_val_zero', Matrix.cons_val_succ']
    simp only [Polynomial.aeval_def, Polynomial.eval₂_C, Polynomial.eval₂_X,
      bivX, bivS, map_add, map_sub, map_mul, map_pow, map_neg,
      RatFunc.algebraMap_eq_C,
      _root_.map_ofNat]
    congr 1
    ring

theorem eta_coefficient_denominator_ne_zero (i j : Fin 3) :
    etaCoefficientDenominator i j ≠ 0 := by
  have hx : symbol ≠ 0 := RatFunc.algebraMap_ne_zero X_ne_zero
  have he : 99*symbol-50 ≠ 0 := by
    intro h
    apply biv_escape_ne_zero
    have hC := congrArg (RatFunc.C (K := RatFunc ℚ)) h
    simpa only [bivX, map_sub, map_mul, _root_.map_ofNat, map_zero] using hC
  have hm : 9*symbol-25 ≠ 0 := by
    intro h
    apply biv_collision_ne_zero
    have hC := congrArg (RatFunc.C (K := RatFunc ℚ)) h
    simpa only [bivX, map_sub, map_mul, _root_.map_ofNat, map_zero] using hC
  fin_cases i <;> fin_cases j
  all_goals
    simp only [etaCoefficientDenominator, Matrix.cons_val_zero', Matrix.cons_val_succ']
    norm_num [mul_ne_zero_iff, pow_ne_zero_iff,
      hx, he, hm]

theorem actual_eta_cleared_polynomial (i j : Fin 3) :
    Polynomial.aeval bivS (etaClearedPolynomial i j) = bivS^3*bivEta i j := by
  have hk : etaSPoleOrder i j ≤ 3 := by fin_cases i <;> fin_cases j <;> decide
  have hd : RatFunc.C (etaCoefficientDenominator i j) ≠ 0 := by
    simpa only [map_zero] using
      (RatFunc.C_injective (K := RatFunc ℚ)).ne (eta_coefficient_denominator_ne_zero i j)
  have hpow : bivS^3 = bivS^(3-etaSPoleOrder i j)*bivS^(etaSPoleOrder i j) := by
    rw [← pow_add]
    congr 1
    omega
  rw [actual_eta_polynomial_fraction, etaClearedPolynomial]
  simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X,
    map_inv₀, RatFunc.algebraMap_eq_C]
  rw [hpow]
  field_simp [bivS_ne_zero, hd]

theorem actual_eta_cleared_degree (i j : Fin 3) :
    (etaClearedPolynomial i j).degree ≤ 6 := by
  fin_cases i <;> fin_cases j
  all_goals
    simp only [etaClearedPolynomial, etaNumeratorPolynomial, etaSPoleOrder,
      Matrix.cons_val_zero', Matrix.cons_val_succ']
    compute_degree <;> norm_num

/-- Literal evaluation of the finite angular Laurent polynomial at lambda. -/
noncomputable def actualEtaAtLambda (i : Fin 3) : RatFunc ℚ :=
  (etaClearedPolynomial i 2).eval lambda/lambda^3

theorem actual_eta_last_column_evaluation (i : Fin 3) :
    actualEtaAtLambda i = sourceEntry ⟨i.val+3, by omega⟩ := by
  have hx : symbol ≠ 0 := RatFunc.algebraMap_ne_zero X_ne_zero
  have he : 99*symbol-50 ≠ 0 := by
    intro h
    apply biv_escape_ne_zero
    have hC := congrArg (RatFunc.C (K := RatFunc ℚ)) h
    simpa only [bivX, map_sub, map_mul, _root_.map_ofNat, map_zero] using hC
  have hm : 9*symbol-25 ≠ 0 := by
    intro h
    apply biv_collision_ne_zero
    have hC := congrArg (RatFunc.C (K := RatFunc ℚ)) h
    simpa only [bivX, map_sub, map_mul, _root_.map_ofNat, map_zero] using hC
  fin_cases i
  all_goals
    simp only [actualEtaAtLambda, etaClearedPolynomial, etaCoefficientDenominator,
      etaSPoleOrder, etaNumeratorPolynomial, sourceEntry, sourceNumerator,
      sourceDenominator, Matrix.cons_val_zero', Matrix.cons_val_succ',
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    norm_num [Polynomial.eval_add,
      Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_neg, Polynomial.eval_C, Polynomial.eval_X,
      Polynomial.eval_ofNat, lambda, symbol,
      map_add, map_sub, map_mul, map_pow, _root_.map_ofNat,
      RatFunc.algebraMap_C, RatFunc.algebraMap_X]
    simp only [symbol, RatFunc.algebraMap_X] at hx he hm
    field_simp [hx, he, hm]
    all_goals ring
    all_goals
      have hm' : -25+RatFunc.X*9 ≠ (0 : RatFunc ℚ) := by
        convert hm using 1
        ring
      field_simp [hm']
      all_goals ring

end

