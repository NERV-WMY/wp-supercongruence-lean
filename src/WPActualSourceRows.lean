noncomputable def bivLambda : RatFunc (RatFunc ℚ) := RatFunc.C lambda
noncomputable def bivB : RatFunc (RatFunc ℚ) := bivLambda / bivS

noncomputable def bivWeight : Fin 3 → RatFunc (RatFunc ℚ) := ![5/72, 23/36, 3/2]

noncomputable def bivNativeMatrix (q : RatFunc (RatFunc ℚ)) :
    Fin 3 → Fin 3 → RatFunc (RatFunc ℚ) :=
  ![![0, 1, 0], ![0, 0, 1],
    ![q/(1-q)*(5/72), q/(1-q)*(23/36), q/(1-q)*(3/2)]]

noncomputable def bivNormalSource (i j : Fin 3) : RatFunc (RatFunc ℚ) :=
  bivWeight i * RatFunc.C (sourceEntry ⟨j.val, by omega⟩) / (bivS - 1) +
    RatFunc.C (sourceEntry ⟨i.val + 3, by omega⟩) * bivWeight j / (bivS - bivLambda)

noncomputable def bivRowConnection (r : Fin 3 → Fin 3 → RatFunc (RatFunc ℚ))
    (i j : Fin 3) : RatFunc (RatFunc ℚ) :=
  ((∑ u : Fin 3, r u j * bivNativeMatrix bivS u i) -
    (∑ v : Fin 3, r i v * bivNativeMatrix bivB v j)) / bivS

