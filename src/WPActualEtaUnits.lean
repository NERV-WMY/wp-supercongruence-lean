import WPFullConductorPrecision
import WPActualEtaPolynomial
import WPActualLaurentIntegrality

open WPFiniteConductorPolynomial

namespace WPForcedSourceStokes

noncomputable section

set_option maxHeartbeats 5000000
set_option maxRecDepth 10000

attribute [local irreducible] polynomialCoefficientSubring integralRationalOrigin

/-- The nine fixed scalar denominators of the unchanged angular primitive. -/
def etaFixedDenominator : Fin 3 → Fin 3 → ℕ :=
  ![![3980063587500000, 15920254350000, 644770301175000],
    ![1105573218750000, 4422292875000, 179102861437500],
    ![552786609375000, 2211146437500, 89551430718750]]

def etaFixedTwoExponent : Fin 3 → Fin 3 → ℕ :=
  ![![5,4,3], ![4,3,2], ![3,2,1]]

def etaFixedThreeExponent : Fin 3 → Fin 3 → ℕ :=
  ![![5,5,9], ![3,3,7], ![3,3,7]]

def etaFixedFiveExponent : Fin 3 → Fin 3 → ℕ :=
  ![![8,5,5], ![9,6,6], ![9,6,6]]

def etaCoefficientXOrder : Fin 3 → Fin 3 → ℕ :=
  ![![2,2,5], ![2,2,5], ![2,2,5]]

def etaCoefficientCollisionOrder : Fin 3 → Fin 3 → ℕ :=
  ![![1,1,1], ![1,1,0], ![1,0,0]]

theorem eta_coefficient_denominator_factorization (i j : Fin 3) :
    etaCoefficientDenominator i j =
      RatFunc.C (etaFixedDenominator i j : ℚ) * symbol^(etaCoefficientXOrder i j) *
        (9*symbol-25)^(etaCoefficientCollisionOrder i j)*(99*symbol-50)^3 := by
  fin_cases i <;> fin_cases j
  all_goals
    norm_num [etaCoefficientDenominator, etaFixedDenominator,
      etaCoefficientXOrder, etaCoefficientCollisionOrder]

theorem eta_fixed_scalar_factorization (i j : Fin 3) :
    etaFixedDenominator i j =
      2^(etaFixedTwoExponent i j)*3^(etaFixedThreeExponent i j)*
        5^(etaFixedFiveExponent i j)*7^2*11^2*13*17 := by
  fin_cases i <;> fin_cases j <;>
    norm_num [etaFixedDenominator, etaFixedTwoExponent,
      etaFixedThreeExponent, etaFixedFiveExponent]

/-- Every actual angular scalar denominator is a unit for all primes at least nineteen. -/
theorem eta_fixed_scalar_inverse_integral (p : ℕ) [Fact p.Prime] (hp : 19≤p)
    (i j : Fin 3) : (1/(etaFixedDenominator i j) : ℚ) ∈ integralSubring p := by
  let R := integralSubring p
  have h2 : (1/2 : ℚ) ∈ R := small_inverse_integral p 2 (by norm_num) (by omega)
  have h3 : (1/3 : ℚ) ∈ R := small_inverse_integral p 3 (by norm_num) (by omega)
  have h5 : (1/5 : ℚ) ∈ R := small_inverse_integral p 5 (by norm_num) (by omega)
  have h7 : (1/7 : ℚ) ∈ R := small_inverse_integral p 7 (by norm_num) (by omega)
  have h11 : (1/11 : ℚ) ∈ R := small_inverse_integral p 11 (by norm_num) (by omega)
  have h13 : (1/13 : ℚ) ∈ R := small_inverse_integral p 13 (by norm_num) (by omega)
  have h17 : (1/17 : ℚ) ∈ R := small_inverse_integral p 17 (by norm_num) (by omega)
  have he : (1/(etaFixedDenominator i j) : ℚ) =
      (1/2)^(etaFixedTwoExponent i j)*(1/3)^(etaFixedThreeExponent i j)*
        (1/5)^(etaFixedFiveExponent i j)*(1/7)^2*(1/11)^2*(1/13)*(1/17) := by
    rw [eta_fixed_scalar_factorization]
    push_cast
    simp only [one_div, mul_inv_rev, inv_pow]
    ring
  rw [he]
  exact R.mul_mem (R.mul_mem (R.mul_mem (R.mul_mem (R.mul_mem
    (R.mul_mem (R.pow_mem h2 _) (R.pow_mem h3 _)) (R.pow_mem h5 _))
      (R.pow_mem h7 2)) (R.pow_mem h11 2)) h13) h17

/-- All actual angular denominator inverses have integral Laurent coefficients at the origin. -/
theorem eta_coefficient_denominator_inverse_integral (p : ℕ) [Fact p.Prime]
    (hp : 19≤p) (i j : Fin 3) :
    (etaCoefficientDenominator i j)⁻¹ ∈
      integralRationalOrigin (integralSubring p) := by
  let R := integralSubring p
  let I := integralRationalOrigin R
  have h2 : (1/2 : ℚ) ∈ R := small_inverse_integral p 2 (by norm_num) (by omega)
  have h3 : (1/3 : ℚ) ∈ R := small_inverse_integral p 3 (by norm_num) (by omega)
  have h5 : (1/5 : ℚ) ∈ R := small_inverse_integral p 5 (by norm_num) (by omega)
  have h11 : (1/11 : ℚ) ∈ R := small_inverse_integral p 11 (by norm_num) (by omega)
  have h9i : (9 : ℚ)⁻¹ ∈ R := by
    rw [show (9 : ℚ)⁻¹=(1/3)^2 by norm_num]
    exact R.pow_mem h3 2
  have h99i : (99 : ℚ)⁻¹ ∈ R := by
    rw [show (99 : ℚ)⁻¹=(1/3)^2*(1/11) by norm_num]
    exact R.mul_mem (R.pow_mem h3 2) h11
  have h925 : (9/25 : ℚ) ∈ R := by
    rw [show (9/25 : ℚ)=9*(1/5)^2 by norm_num]
    exact R.mul_mem (natCast_mem R 9) (R.pow_mem h5 2)
  have h9950 : (99/50 : ℚ) ∈ R := by
    rw [show (99/50 : ℚ)=99*(1/2)*(1/5)^2 by norm_num]
    exact R.mul_mem (R.mul_mem (natCast_mem R 99) h2) (R.pow_mem h5 2)
  have hM : (9*symbol-25)⁻¹ ∈ I := by
    simpa only [_root_.map_ofNat] using
      integral_rational_origin_affine_inverse R 9 25 (by norm_num) (by norm_num) h9i h925
  have he : (99*symbol-50)⁻¹ ∈ I := by
    simpa only [_root_.map_ofNat] using
      integral_rational_origin_affine_inverse R 99 50 (by norm_num) (by norm_num) h99i h9950
  have hd : RatFunc.C ((etaFixedDenominator i j : ℚ)⁻¹) ∈ I :=
    integral_rational_origin_scalar R _
      (by simpa only [one_div] using eta_fixed_scalar_inverse_integral p hp i j)
  have hform : (etaCoefficientDenominator i j)⁻¹ =
      RatFunc.C ((etaFixedDenominator i j : ℚ)⁻¹) *
        (symbol⁻¹)^(etaCoefficientXOrder i j) *
        ((9*symbol-25)⁻¹)^(etaCoefficientCollisionOrder i j)*
        ((99*symbol-50)⁻¹)^3 := by
    rw [eta_coefficient_denominator_factorization]
    simp only [mul_inv_rev, ← inv_pow, ← map_inv₀]
    ring
  rw [hform]
  exact I.mul_mem (I.mul_mem (I.mul_mem hd
    (I.pow_mem (integral_rational_origin_symbol_inverse R) _))
    (I.pow_mem hM _)) (I.pow_mem he 3)

