/-- The unchanged angular numerator has integral coefficients as rational Laurent functions. -/
theorem eta_numerator_polynomial_integral (R : Subring ℚ) (i j : Fin 3) :
    etaNumeratorPolynomial i j ∈ polynomialCoefficientSubring (integralRationalOrigin R) :=
  eta_numerator_polynomial_integral_of_symbol _ (integral_rational_origin_symbol R) i j

theorem eta_cleared_polynomial_integral (p : ℕ) [Fact p.Prime] (hp : 19≤p)
    (i j : Fin 3) :
    etaClearedPolynomial i j ∈ polynomialCoefficientSubring (integralRationalOrigin (integralSubring p)) := by
  let I := integralRationalOrigin (integralSubring p)
  let P := polynomialCoefficientSubring I
  exact P.mul_mem (P.mul_mem
    (C_mem_polynomialCoefficientSubring I _ (eta_coefficient_denominator_inverse_integral p hp i j))
    (P.pow_mem (X_mem_polynomialCoefficientSubring I) _)) (eta_numerator_polynomial_integral _ i j)

theorem actual_lambda_origin_integral (p : ℕ) [Fact p.Prime] (hp : 19≤p) :
    lambda ∈ integralRationalOrigin (integralSubring p) := by
  let R := integralSubring p
  let I := integralRationalOrigin R
  have h5 : (1/5 : ℚ) ∈ R := small_inverse_integral p 5 (by norm_num) (by omega)
  have ht : (729/15625 : ℚ) ∈ R := by
    rw [show (729/15625 : ℚ)=729*(1/5)^6 by norm_num]
    exact R.mul_mem (natCast_mem R 729) (R.pow_mem h5 6)
  have hs : (729/15625 : RatFunc ℚ) = RatFunc.C (729/15625 : ℚ) := by
    norm_num [map_div₀]
  unfold lambda
  rw [hs]
  exact I.mul_mem (integral_rational_origin_scalar R _ ht)
    (I.pow_mem (integral_rational_origin_symbol R) 3)

theorem actual_lambda_inverse_origin_integral (p : ℕ) [Fact p.Prime] (hp : 19≤p) :
    lambda⁻¹ ∈ integralRationalOrigin (integralSubring p) := by
  let R := integralSubring p
  let I := integralRationalOrigin R
  have h3 : (1/3 : ℚ) ∈ R := small_inverse_integral p 3 (by norm_num) (by omega)
  have ht : (15625/729 : ℚ) ∈ R := by
    rw [show (15625/729 : ℚ)=15625*(1/3)^6 by norm_num]
    exact R.mul_mem (natCast_mem R 15625) (R.pow_mem h3 6)
  have hs : (729/15625 : RatFunc ℚ)⁻¹ = RatFunc.C (15625/729 : ℚ) := by
    norm_num [map_div₀]
  unfold lambda
  rw [mul_inv_rev, ← inv_pow, hs]
  exact I.mul_mem (I.pow_mem (integral_rational_origin_symbol_inverse R) 3)
    (integral_rational_origin_scalar R _ ht)

